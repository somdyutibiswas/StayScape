<% layout("/layouts/boilerplate") %> 

   <style>
    /* FILTER BAR */
    #filters {
        display: flex;
        align-items: center;
        max-width: 1500px;
        margin: 0 auto;
        padding: 0.8rem 0.8rem;
        gap: 1.6rem;
        overflow-x: auto;
        scrollbar-width: none;
    }
    #filters::-webkit-scrollbar {
        display: none;
    }

    /* FILTER ITEMS */

    .filter {
        flex: 0 0 auto;
        min-width: 55px;
        text-align: center;
        opacity: 0.65;
        margin: 0.5rem 0;
        /* transition: opacity 0.2s ease; */
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .filter:hover {
        opacity: 1;
        /* cursor: pointer; */
        color: #fe424d;
        transform: translateY(-2px);
    }
    .filter i {
        font-size: 1.2rem;
        margin-bottom: 0.35rem;
        transition: color 0.2s ease;
    }
    .filter p {
        font-size: 0.78rem;
        margin: 0;
        white-space: nowrap;
    }
    /* SELECTED CATEGORY */
        .filter.active {
            opacity: 1;
            color: #fe424d;
            font-weight: 600;
        }
        .filter.active i {
            color: #fe424d;
        }

/* TAX TOGGLE */

.tax-toggle {
    margin-left: auto;
    flex: 0 0 auto;
    padding: 0.65rem 1rem;
    border: 1px solid #dddddd;
    border-radius: 0.75rem;
    background: #fff;
}
.tax-toggle .form-check-reverse {
    margin: 0;
}

.tax-toggle .form-check-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    cursor: pointer;
}

.tax-toggle .form-check-label span {
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.3;
    color: #444;
    white-space: nowrap;
}

#switchCheckDefault {
    width: 2.5rem !important;
    height: 1.35rem !important;
    margin: 0 !important;
    flex-shrink: 0;
    cursor: pointer;
    background-color: #d9d9d9 !important;
    border-color: #d9d9d9 !important;
    box-shadow: none !important;
}

/* SWITCH - ON = RED */
#switchCheckDefault:checked {
    background-color: #fe424d !important;
    border-color: #fe424d !important;
    box-shadow: none !important;
}

/* REMOVE BLUE FOCUS GLOW */
#switchCheckDefault:focus {
    outline: none !important;
    box-shadow: none !important;
}

    /* MOBILE */
    @media (max-width: 900px) {
        #filters {
            gap: 1.5rem;
            padding: 0.8rem 1rem;
        }
        .tax-toggle {
            margin-left: 0;
        }
    }
</style>

    <div id="filters">
        <div class="filter"  onclick="filterListings('Popular')">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Popular</p>
        </div>
